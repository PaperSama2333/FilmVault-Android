<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="filmvault.db" />
        <include domain="file" path="media/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="filmvault.db" />
        <include domain="file" path="media/" />
        <include domain="file" path="avatar/" />
    </device-transfer>
</data-extraction-rules>
